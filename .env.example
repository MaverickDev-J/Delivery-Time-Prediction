# ==========================================
# DeliverIQ Platform Environment Variables
# ==========================================

# General Service Config
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Redis (Caching, Locks, Streams Message Bus)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL Databases
DATABASE_URL=postgresql://deliveriq:deliveriq_password@localhost:5432/deliveriq
ORDERS_DATABASE_URL=postgresql://deliveriq:deliveriq_password@localhost:5432/orders_db
PAYMENTS_DATABASE_URL=postgresql://deliveriq:deliveriq_password@localhost:5432/payments_db
INVENTORY_DATABASE_URL=postgresql://deliveriq:deliveriq_password@localhost:5432/inventory_db
SAGA_DATABASE_URL=postgresql://deliveriq:deliveriq_password@localhost:5432/saga_db
MONITORING_DATABASE_URL=postgresql://deliveriq:deliveriq_password@localhost:5432/monitoring_db

# MLflow Tracking & DagsHub (Optional for remote tracking, defaults to local mlruns/)
MLFLOW_TRACKING_URI=
DAGSHUB_REPO_OWNER=
DAGSHUB_REPO_NAME=Delivery-Time-Prediction
DAGSHUB_TOKEN=
